# Serve a report over HTTP with the standard library only.
#
#   sudo cp deploy/netwatch.service /etc/systemd/system/
#   sudo systemctl edit netwatch.service   # set the report path and host
#   sudo systemctl enable --now netwatch
[Unit]
Description=NetWatch dashboard
After=network-online.target

[Service]
Type=simple
User=netwatch
Group=netwatch
# --host 127.0.0.1 is the shipped default deliberately: the dashboard API has
# no authentication, so publishing it to the network is a decision an operator
# must make, not a default to inherit. To expose it, override the unit with
#   sudo systemctl edit netwatch.service
# and repeat ExecStart there with --host 0.0.0.0 (or another interface
# address) -- plus whatever network-layer restriction you intend to depend on.
ExecStart=/usr/bin/env netwatch serve --report /var/lib/netwatch/report.json --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/netwatch

[Install]
WantedBy=multi-user.target
